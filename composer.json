{
    "name": "agriserv/exports",
    "description": "Queued spreadsheet exports for Laravel apps. Wraps maatwebsite/excel with a tracked ExportJob + Livewire status UI.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/queue": "^10.0|^11.0|^12.0",
        "illuminate/bus": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "maatwebsite/excel": "^3.1",
        "livewire/livewire": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Agriserv\\Exports\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Agriserv\\Exports\\ExportsServiceProvider"
            ],
            "aliases": {
                "QueuedExports": "Agriserv\\Exports\\Facades\\QueuedExports"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
